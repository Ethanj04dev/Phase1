# Copy to .env and fill in from your Supabase project settings.
#
# Both values are safe to ship in the app bundle. EXPO_PUBLIC_ variables are
# inlined at build time, and the anon key is designed to be public -- row-level
# security is what actually protects athlete data.
#
# NEVER put the service_role key here or anywhere else in this app. It bypasses
# row-level security entirely and would give any copy of the binary full read
# and write access to every athlete's data.
#
# Leaving these unset is supported: the app runs entirely on local device
# storage and never asks anyone to sign in.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
